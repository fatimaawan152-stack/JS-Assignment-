// Question 1: Grading System

let marks = prompt("Enter Marks");

if (marks >= 90) {
    console.log("Grade A+");
}
else if (marks >= 80) {
    console.log("Grade A");
}
else if (marks >= 70) {
    console.log("Grade B");
}
else if (marks >= 60) {
    console.log("Grade C");
}
else if (marks >= 50) {
    console.log("Grade D");
}
else {
    console.log("Fail");
}


// Question 2: Even or Odd

let num = prompt("Enter Number");

if (num % 2 == 0) {
    console.log("Even");
}
else {
    console.log("Odd");
}


// Question 3: Multiplication Table

let table = prompt("Enter Number");

for (let i = 1; i <= 10; i++) {
    console.log(table + " x " + i + " = " + table * i);
}


// Question 4: Sum of Natural Numbers

let n = prompt("Enter N");
let sum = 0;

for (let i = 1; i <= n; i++) {
    sum = sum + i;
}

console.log("Sum = " + sum);


// Question 5: Largest of Three Numbers

let a = prompt("Enter First Number");
let b = prompt("Enter Second Number");
let c = prompt("Enter Third Number");

if (a > b && a > c) {
    console.log("Largest Number = " + a);
}
else if (b > a && b > c) {
    console.log("Largest Number = " + b);
}
else {
    console.log("Largest Number = " + c);
}
